{
  "name": "afterplume",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "prebuild": "npm run model:prepare",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsx packages/verifier/cli.ts",
    "data:prepare": "python scripts/prepare_data.py",
    "model:prepare": "node scripts/prepare-model.mjs",
    "evaluate": "tsx scripts/evaluate.ts",
    "benchmark:browser": "node scripts/browser-benchmark.mjs",
    "samples": "tsx scripts/samples.ts",
    "ledger:walkthrough": "tsx scripts/ledger-walkthrough.ts",
    "ledger:browser": "node scripts/browser-ledger.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "contracts:test": "hardhat test nodejs --config contracts/hardhat.config.ts",
    "contracts:compile": "hardhat compile --config contracts/hardhat.config.ts",
    "chain:local": "hardhat node --config contracts/hardhat.config.ts",
    "chain:deploy": "hardhat run contracts/scripts/deploy.ts --config contracts/hardhat.config.ts --network localhost",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run contracts:test && npm run build",
    "evaluate:batch": "tsx scripts/batch-evaluate.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "fflate": "0.8.2",
    "json-canonicalize": "3.0.1",
    "lucide-react": "0.468.0",
    "papaparse": "5.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "hardhat": "3.19.0",
    "prettier": "3.6.2",
    "solc": "0.8.28",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
